# Copy to .env.production (gitignored); replace ALL example credentials.
# SITE_ADDRESS must resolve to VPS public IP before enabling real-user logins.
SITE_ADDRESS=example.com
ACME_EMAIL=owner@example.com

NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://example.com
TRUST_PROXY_HOPS=1

DB_HOST=db
DB_PORT=3306
DB_NAME=serpente_nail
DB_USER=serpente
DB_PASSWORD=REPLACE_WITH_STRONG_RANDOM_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_STRONG_RANDOM_ROOT_PASSWORD
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_EXPIRES_IN_SECONDS=600
REFRESH_SESSION_DAYS=7

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM_EMAIL=
GOOGLE_MAPS_URL=
